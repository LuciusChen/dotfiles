#!/bin/sh

# sudo inherits SSH_CONNECTION or Rex's REX_BLOCK from the shell (or Codex)
# that invokes it. Rex terminals use REX_BLOCK=block:<id>, even without SSH.
# pam_exec runs this helper with sudo as its direct parent; seteuid lets the
# helper read the environment of the set-user-ID sudo process.
grep -aqz -e '^SSH_CONNECTION=' -e '^REX_BLOCK=block:.' "/proc/$PPID/environ"
