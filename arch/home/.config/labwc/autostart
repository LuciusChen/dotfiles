#!/bin/sh

# Integrate portals and other graphical user services with this session.
systemctl --user --no-block start labwc-session.target

# Apply the matching laptop/docked display profile.
kanshi >/dev/null 2>&1 &

# Noctalia owns the bar, launcher, notifications, clipboard, lock and idle UI.
noctalia --daemon

# Per-app Super+letter keys and their overlay; starts tracking windows early.
~/.local/bin/keydock daemon >/dev/null 2>&1 &

# Auto-mount removable drives and surface mount events through Noctalia.
udiskie --automount --notify --smart-tray &

# Session applications.
fcitx5 -d -r
~/.dropbox-dist/dropboxd >/dev/null 2>&1 &

# Noctalia's GTK templates synchronize the light/dark appearance.
gsettings set org.gnome.desktop.interface icon-theme "Papirus-Dark"
