;; System-wide keyboard remapping configuration.
;;
;; Keys outside the mappings below pass through unchanged. Processing them is
;; still required so that another key immediately resolves tap-hold actions.
(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  log-layer-changes no
  ;; Lets tap-hold keys resolve together, e.g. Caps (Ctrl) held with ; for Ctrl+Left.
  concurrent-tap-hold yes
)

;; defsrc is required even when all layers use the key-oriented deflayermap
;; syntax.
(defsrc)

;; Run keydock as the desktop user; kanata itself runs as root.
(defvar
  keydock (runuser -u lucius -- env XDG_RUNTIME_DIR=/run/user/1000
           /home/lucius/.local/bin/keydock)
)

;; Ask keydock to toggle an app.
(deftemplate kd (letter)
  (cmd $keydock key $letter)
)

;; A key that also hides the keyboard, so it does not cover the screen while
;; the layer is in use.
(deftemplate pk (key)
  (multi $key (cmd $keydock peek off))
)

;; Tap for the key itself; hold for a layer, while keydock shows that hint.
(deftemplate hold-layer (key layer hint)
  (tap-hold-press 200 200 $key
    (multi (layer-while-held $layer)
           (cmd $keydock peek $hint)
           (on-release tap-vkey peek-off)))
)

(defvirtualkeys
  peek-off (cmd $keydock peek off)
)

(defalias
  ;; Tap Caps Lock for Escape; hold it for Left Control.
  caps-ctrl (tap-hold-press 200 200 esc lctl)

  ;; Tap semicolon normally; hold it for numbers and navigation.
  semi-numnav (t! hold-layer ; numnav numnav)

  ;; The same layer under Super, where its arrows move windows; only the hint
  ;; differs.
  semi-super-nav (t! hold-layer ; numnav super-nav)

  ;; Tap Tab normally; hold it for the keydock layer.
  tab-apps (t! hold-layer tab apps ())

  ;; Super stays a modifier; while it is held, keydock shows its bindings.
  met-super (multi lmet
                   (layer-while-held super)
                   (cmd $keydock peek super)
                   (on-release tap-vkey peek-off))
)

(deflayermap (base)
  caps @caps-ctrl
  esc  caps
  ;    @semi-numnav
  tab  @tab-apps
  lmet @met-super
)

;; The keys bound with Super in labwc's rc.xml.
(deflayermap (super)
  a (t! pk a)
  b (t! pk b)
  c (t! pk c)
  f (t! pk f)
  l (t! pk l)
  n (t! pk n)
  q (t! pk q)
  s (t! pk s)
  1 (t! pk 1)
  2 (t! pk 2)
  , (t! pk ,)
  grv (t! pk grv)
  spc (t! pk spc)
  sys (t! pk sys)
  left (t! pk left)
  right (t! pk right)
  up (t! pk up)
  down (t! pk down)
  ;    @semi-super-nav
)

;; Matches the Corne layout: numbers under the left hand, navigation under
;; the right.
(deflayermap (numnav)
  q (t! pk 1)
  w (t! pk 2)
  e (t! pk 3)
  r (t! pk 4)
  t (t! pk 5)
  a (t! pk 6)
  s (t! pk 7)
  d (t! pk 8)
  f (t! pk 9)
  g (t! pk 0)

  h (t! pk left)
  j (t! pk down)
  k (t! pk up)
  l (t! pk right)

  i (t! pk del)
  n (t! pk home)
  m (t! pk pgdn)
  , (t! pk pgup)
  . (t! pk end)
)

(deflayermap (apps)
  a (t! kd a)
  b (t! kd b)
  c (t! kd c)
  d (t! kd d)
  e (t! kd e)
  f (t! kd f)
  g (t! kd g)
  h (t! kd h)
  i (t! kd i)
  j (t! kd j)
  k (t! kd k)
  l (t! kd l)
  m (t! kd m)
  n (t! kd n)
  o (t! kd o)
  p (t! kd p)
  q (t! kd q)
  r (t! kd r)
  s (t! kd s)
  t (t! kd t)
  u (t! kd u)
  v (t! kd v)
  w (t! kd w)
  x (t! kd x)
  y (t! kd y)
  z (t! kd z)
  1 (t! kd 1)
  2 (t! kd 2)
  3 (t! kd 3)
  4 (t! kd 4)
  5 (t! kd 5)
  6 (t! kd 6)
  7 (t! kd 7)
  8 (t! kd 8)
  9 (t! kd 9)
  / (cmd $keydock overlay)
)

;; The ThinkPad Copilot key reports Left Meta + Left Shift + F23. Suppress
;; that synthetic chord and expose a held Right Meta modifier instead.
(defchordsv2
  (lmet lsft f23) rmet 100 all-released ()
)
