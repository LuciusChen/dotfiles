;; System-wide keyboard remapping configuration.
;;
;; Keys outside the mappings below pass through unchanged. Processing them is
;; still required so that another key immediately resolves tap-hold actions.
(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  log-layer-changes no
  ;; Lets tap-hold keys resolve together, e.g. Caps (Ctrl) held with ; for Ctrl+Left.
  concurrent-tap-hold yes
)

;; defsrc is required even when all layers use the key-oriented deflayermap
;; syntax.
(defsrc)

(defalias
  ;; Tap Caps Lock for Escape; hold it for Left Control.
  caps-ctrl (tap-hold-press 200 200 esc lctl)

  ;; Tap semicolon normally; hold it for numbers and navigation. While it is
  ;; held, keydock shows the layer on a keyboard.
  semi-numnav (tap-hold-press 200 200 ;
                (multi (layer-while-held numnav)
                       (cmd runuser -u lucius -- env XDG_RUNTIME_DIR=/run/user/1000
                            /home/lucius/.local/bin/keydock peek numnav)
                       (on-release tap-vkey peek-off)))

  ;; Tap Tab normally; hold it for the keydock layer. While it is held,
  ;; keydock shows the pinned apps on a keyboard.
  tab-apps (tap-hold-press 200 200 tab
             (multi (layer-while-held apps)
                    (cmd runuser -u lucius -- env XDG_RUNTIME_DIR=/run/user/1000
                         /home/lucius/.local/bin/keydock peek)
                    (on-release tap-vkey peek-off)))
)

;; Ask the keydock daemon, as the desktop user, to toggle an app.
(deftemplate kd (letter)
  (cmd runuser -u lucius -- env XDG_RUNTIME_DIR=/run/user/1000
       /home/lucius/.local/bin/keydock key $letter)
)

;; A numnav key that also hides the keyboard, so it does not cover the screen
;; while navigating.
(deftemplate nn (key)
  (multi $key
         (cmd runuser -u lucius -- env XDG_RUNTIME_DIR=/run/user/1000
              /home/lucius/.local/bin/keydock peek off))
)

(defvirtualkeys
  peek-off (cmd runuser -u lucius -- env XDG_RUNTIME_DIR=/run/user/1000
                /home/lucius/.local/bin/keydock peek off)
)

(deflayermap (base)
  caps @caps-ctrl
  esc  caps
  ;    @semi-numnav
  tab  @tab-apps
)

;; Matches the Corne layout: numbers under the left hand, navigation under
;; the right.
(deflayermap (numnav)
  q (t! nn 1)
  w (t! nn 2)
  e (t! nn 3)
  r (t! nn 4)
  t (t! nn 5)
  a (t! nn 6)
  s (t! nn 7)
  d (t! nn 8)
  f (t! nn 9)
  g (t! nn 0)

  h (t! nn left)
  j (t! nn down)
  k (t! nn up)
  l (t! nn right)

  i (t! nn del)
  n (t! nn home)
  m (t! nn pgdn)
  , (t! nn pgup)
  . (t! nn end)
)

(deflayermap (apps)
  a (t! kd a)
  b (t! kd b)
  c (t! kd c)
  d (t! kd d)
  e (t! kd e)
  f (t! kd f)
  g (t! kd g)
  h (t! kd h)
  i (t! kd i)
  j (t! kd j)
  k (t! kd k)
  l (t! kd l)
  m (t! kd m)
  n (t! kd n)
  o (t! kd o)
  p (t! kd p)
  q (t! kd q)
  r (t! kd r)
  s (t! kd s)
  t (t! kd t)
  u (t! kd u)
  v (t! kd v)
  w (t! kd w)
  x (t! kd x)
  y (t! kd y)
  z (t! kd z)
  / (cmd runuser -u lucius -- env XDG_RUNTIME_DIR=/run/user/1000
         /home/lucius/.local/bin/keydock overlay)
)

;; The ThinkPad Copilot key reports Left Meta + Left Shift + F23. Suppress
;; that synthetic chord and expose a held Right Meta modifier instead.
(defchordsv2
  (lmet lsft f23) rmet 100 all-released ()
)
