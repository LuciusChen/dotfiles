#!/usr/bin/env bash
set -euo pipefail

if (( EUID != 0 )); then
    echo "Run this script with sudo." >&2
    exit 1
fi

script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
arch_dir="$(CDPATH= cd -- "${script_dir}/.." && pwd)"

install -Dm0755 \
    "${arch_dir}/usr/local/libexec/pam-sudo-is-remote" \
    /usr/local/libexec/pam-sudo-is-remote
install -Dm0644 \
    "${arch_dir}/etc/pam.d/sudo" \
    /etc/pam.d/sudo

echo "Installed SSH-aware sudo PAM policy."
