#%PAM-1.0
# SSH sessions use password authentication; local sessions try fingerprint first.
auth            [success=1 default=ignore] pam_exec.so quiet quiet_log seteuid /usr/local/libexec/pam-sudo-is-remote
auth            sufficient      pam_fprintd.so
auth		include		system-auth
account		include		system-auth
session		include		system-auth
